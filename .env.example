# Painel Palworld — variáveis de ambiente
#
# No CasaOS/ZimaOS: defina os valores direto no "Palworld Server.yml"
# (seção environment de cada serviço) pela interface.
#
# Quem roda docker compose na mão: copie este arquivo para .env
# e referencie as variáveis no compose (ex.: PANEL_PASSWORD=${PANEL_PASSWORD}).
#
# cp .env.example .env && chmod 600 .env

# ── Serviço "Painel" ──────────────────────────────────────────────

# Porta onde o site do painel abre
PANEL_PORT=3564

# Senha para ENTRAR no painel.
# Se ficar vazia/fraca, o painel GERA uma senha forte automaticamente
# e mostra no log do container na primeira execução.
PANEL_PASSWORD=

# Endereço da REST API do jogo (dentro do compose: nome do serviço)
PALWORLD_API=http://palworld:8212

# Deve ser IGUAL ao ADMIN_PASSWORD do serviço "palworld" abaixo.
# Sem ela o painel abre, mas não consegue comandar o jogo.
ADMIN_PASSWORD=

# Caminho do PalWorldSettings.ini dentro do container — habilita o
# editor de configurações. Com o mount padrão abaixo, use:
PALWORLD_INI=/palworld/Pal/Saved/Config/LinuxServer/PalWorldSettings.ini

# Pasta de saves do jogo — habilita backup/restauração pelo painel.
PALWORLD_SAVE_DIR=/palworld/Pal/Saved/SaveGames

# Pasta de backups montada no painel (listagem/download/criação)
BACKUP_DIR=/data/backups

# Página pública /status (0 = desliga)
PUBLIC_STATUS=1

# Endereço exibido na página pública para os jogadores conectarem
PUBLIC_HOST=

# Timeout das chamadas à API do jogo (segundos)
API_TIMEOUT=4

# ── Serviço "palworld" (servidor de jogo) ─────────────────────────

# Mesma senha do ADMIN_PASSWORD acima
GAME_ADMIN_PASSWORD=

PORT=8211
REST_API_PORT=8212
PLAYERS=4
SERVER_NAME=
SERVER_DESCRIPTION=
TZ=UTC
